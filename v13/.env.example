# Copy to .env (here or in the repo root) — the server reads the nearest .env at or above v13/.
# Use plain KEY=VALUE entries, no quotes needed.
AI_GATEWAY_API_KEY=vck_your_vercel_ai_gateway_key
# Optional: agent model routed through the Vercel AI Gateway (default google/gemini-4-hydrogen),
# or "demo" for the scripted offline agent.
# RELAY_CHAT_MODEL=google/gemini-4-hydrogen
# Optional: extra browser origins / hosts allowed to call the API and /mcp.
# RELAY_ALLOWED_ORIGINS=https://your.app
# RELAY_ALLOWED_HOSTS=myhost:8813
