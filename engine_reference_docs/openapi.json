  "components": {
    "schemas": {
      "AutonomyPolicy": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "ADVISORY",
              "HUMAN_APPROVAL",
              "BOUNDED_AUTO"
            ],
            "title": "Mode",
            "default": "HUMAN_APPROVAL"
          },
          "max_auto_cost_units": {
            "type": "number",
            "minimum": 0.0,
            "title": "Max Auto Cost Units",
            "default": 0
          },
          "allow_simulated_dispatch": {
            "type": "boolean",
            "title": "Allow Simulated Dispatch",
            "default": true
          }
        },
        "type": "object",
        "title": "AutonomyPolicy"
      },
      "BatchEvents": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "BatchEvents"
      },
      "BenchmarkRequest": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "runs": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 100.0,
            "title": "Runs",
            "default": 10000
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 2026
          }
        },
        "type": "object",
        "required": [
          "decision_id"
        ],
        "title": "BenchmarkRequest"
      },
      "EvaluationRequest": {
        "properties": {
          "as_of": {
            "anyOf": [
